{
  "name": "london-news-monorepo",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @londonnews/web",
    "build": "npm run build --workspace @londonnews/web",
    "build:production": "npm run build:production --workspace @londonnews/web",
    "start": "npm run start --workspace @londonnews/web",
    "typecheck": "npm run typecheck --workspace @londonnews/web",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run db:generate --workspace @londonnews/web",
    "db:generate:production": "npm run db:generate:production --workspace @londonnews/web",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @londonnews/web",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @londonnews/web",
    "db:migrate:status": "npm run db:migrate:status --workspace @londonnews/web",
    "db:push": "npm run db:push --workspace @londonnews/web",
    "db:seed": "npm run db:seed --workspace @londonnews/web",
    "db:seed:production": "npm run db:seed:production --workspace @londonnews/web",
    "db:setup": "npm run db:setup --workspace @londonnews/web"
  },
  "dependencies": {
    "lucide-react": "^1.28.0"
  }
}
